  <Sequence sap2010:Annotation.AnnotationText="Framework: runs the TearDown hook after every test, when the test threw (from the template's Catch, with the exception) and when it ran to the end or was stopped (from its Finally, with null).&#xA;Never throws, so it never replaces the test's own result. Bounded by TearDownTimeout (5 minutes when Config is not loaded)." DisplayName="FinalizeTestRun" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <TryCatch DisplayName="Run TearDown without failing the test" sap2010:WorkflowViewState.IdRef="TryCatch_1">
      <TryCatch.Try>
        <Sequence DisplayName="Try" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <ui:TimeoutScope DisplayName="TearDown timeout" sap2010:WorkflowViewState.IdRef="TimeoutScope_1">
            <ui:TimeoutScope.ThrowExceptionAfter>
              <InArgument x:TypeArguments="s:TimeSpan">
                <CSharpValue x:TypeArguments="s:TimeSpan" sap2010:WorkflowViewState.IdRef="CSharpValue`1_1">(GlobalVariables.Config != null &amp;&amp; GlobalVariables.Config.ContainsKey("TearDownTimeout")) ? (TimeSpan)GlobalVariables.Config["TearDownTimeout"] : TimeSpan.FromMinutes(5)</CSharpValue>
              </InArgument>
            </ui:TimeoutScope.ThrowExceptionAfter>
            <ui:TimeoutScope.TimeoutMessage>
              <InArgument x:TypeArguments="x:String">TearDown exceeded TearDownTimeout</InArgument>
            </ui:TimeoutScope.TimeoutMessage>
            <ui:TimeoutScope.Body>
              <ActivityAction x:TypeArguments="Activity">
                <Sequence DisplayName="Do" sap2010:WorkflowViewState.IdRef="Sequence_3">
                  <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="TearDown - Invoke Workflow File (Hooks\TearDown.xaml)" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="Hooks\TearDown.xaml">
                    <ui:InvokeWorkflowFile.Arguments>
                      <InArgument x:TypeArguments="s:Exception" x:Key="in_Exception">
                        <CSharpValue x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="CSharpValue`1_2">in_Exception</CSharpValue>
                      </InArgument>
                    </ui:InvokeWorkflowFile.Arguments>
                  </ui:InvokeWorkflowFile>
                </Sequence>
              </ActivityAction>
            </ui:TimeoutScope.Body>
          </ui:TimeoutScope>
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch`1_1">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="tearDownException" />
            </ActivityAction.Argument>
            <Sequence DisplayName="Catch" sap2010:WorkflowViewState.IdRef="Sequence_4">
              <ui:LogMessage DisplayName="Log TearDown failure" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Error">
                <ui:LogMessage.Message>
                  <InArgument x:TypeArguments="x:Object">
                    <CSharpValue x:TypeArguments="x:Object" sap2010:WorkflowViewState.IdRef="CSharpValue`1_3">"FinalizeTestRun - TearDown failed and was ignored: " + tearDownException.GetType().Name + ": " + tearDownException.Message</CSharpValue>
                  </InArgument>
                </ui:LogMessage.Message>
              </ui:LogMessage>
            </Sequence>
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>
  </Sequence>
</Activity>
