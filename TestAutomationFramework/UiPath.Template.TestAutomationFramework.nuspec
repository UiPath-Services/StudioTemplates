<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>UiPath.Template.TestAutomationFramework</id>
    <version>26.10.0</version>
    <title>Test Automation Framework</title>
    <authors>UiPath</authors>
    <owners>UiPath</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <icon>images\icon.png</icon>
    <projectUrl>https://docs.uipath.com/test-suite</projectUrl>
    <description>Test Automation Framework for Windows and cross-platform testing projects in Visual Basic and C#. Includes reusable setup and teardown, configuration, and execution templates.</description>
    <summary>Test Automation Framework</summary>
    <copyright>UiPath</copyright>
    <language>en-US</language>
    <tags>VisualBasic VB C# UiPathStudioProcess UiPathStudioTemplate Test Framework TestAutomation TestAutomationFramework TestCloud TestSuite</tags>
  </metadata>
  <files>
    <!-- Preserve ptN/.local/template.json while excluding project build and user state. -->
    <file src="contentFiles\**\*" target="contentFiles" exclude="contentFiles\any\any\pt*\*\.local\**;contentFiles\**\.package\**;contentFiles\**\.settings\**;contentFiles\**\.tmh\**;contentFiles\**\.codedworkflows\**;contentFiles\**\bin\**;contentFiles\**\obj\**;contentFiles\**\.gitignore" />
    <file src="images\**\*" target="images" />
  </files>
</package>
