  <Sequence DisplayName="ExpenseFlow - Main" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="dt_Expenses" />
      <Variable x:TypeArguments="sd:DataTable" Name="dt_Results" />
      <Variable x:TypeArguments="x:Boolean" Name="rowIsValid" />
      <Variable x:TypeArguments="x:String" Name="rowMessage" />
      <Variable x:TypeArguments="x:Int32" Name="validCount" />
      <Variable x:TypeArguments="x:Int32" Name="invalidCount" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:LogMessage DisplayName="Log the start of the run" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[&quot;ExpenseFlow run started.&quot;]" />
    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="ReadExpenses - Invoke Workflow File (Workflows\ReadExpenses.xaml)" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="Workflows\ReadExpenses.xaml">
      <ui:InvokeWorkflowFile.Arguments>
        <InArgument x:TypeArguments="x:String" x:Key="in_WorkbookPath">Data/expenses.xlsx</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_SheetName">Expenses</InArgument>
        <OutArgument x:TypeArguments="sd:DataTable" x:Key="out_dt_Expenses">[dt_Expenses]</OutArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <ui:GenerateDataTable ColumnSeparators="{x:Null}" ColumnSizes="{x:Null}" NewLineSeparator="{x:Null}" Positions="{x:Null}" AutoDetectTypes="False" CSVParsing="True" DataTable="[dt_Results]" DisplayName="Create the empty results table" sap2010:WorkflowViewState.IdRef="GenerateDataTable_1" Input="EmployeeId,ExpenseDate,Category,Amount,Currency,Receipt,Notes,Status,Reason" UseColumnHeader="True" />
    <ui:ForEach x:TypeArguments="sd:DataRow" CurrentIndex="{x:Null}" DisplayName="For Each expense claim" sap2010:WorkflowViewState.IdRef="ForEach`1_1" Values="[dt_Expenses.Rows]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="ValidateExpense - Invoke Workflow File (Workflows\ValidateExpense.xaml)" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_2" UnSafe="False" WorkflowFileName="Workflows\ValidateExpense.xaml">
              <ui:InvokeWorkflowFile.Arguments>
                <InArgument x:TypeArguments="x:Double" x:Key="in_Amount">[Convert.ToDouble(row("Amount"), CultureInfo.InvariantCulture)]</InArgument>
                <InArgument x:TypeArguments="x:String" x:Key="in_Category">[row("Category").ToString()]</InArgument>
                <InArgument x:TypeArguments="x:Boolean" x:Key="in_ReceiptAttached">[row("Receipt").ToString().Trim().ToLowerInvariant() = "yes"]</InArgument>
                <InArgument x:TypeArguments="x:String" x:Key="in_Notes">[row("Notes").ToString()]</InArgument>
                <OutArgument x:TypeArguments="x:Boolean" x:Key="out_IsValid">[rowIsValid]</OutArgument>
                <OutArgument x:TypeArguments="x:String" x:Key="out_ValidationMessage">[rowMessage]</OutArgument>
              </ui:InvokeWorkflowFile.Arguments>
            </ui:InvokeWorkflowFile>
            <ui:AddDataRow DataRow="{x:Null}" ArrayRow="[New Object() { row(&quot;EmployeeId&quot;), row(&quot;ExpenseDate&quot;), row(&quot;Category&quot;), row(&quot;Amount&quot;), row(&quot;Currency&quot;), row(&quot;Receipt&quot;), row(&quot;Notes&quot;), If(rowIsValid, &quot;Valid&quot;, &quot;Rejected&quot;), rowMessage }]" DataTable="[dt_Results]" DisplayName="Record the outcome for this claim" sap2010:WorkflowViewState.IdRef="AddDataRow_1" />
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <Assign x:TypeArguments="x:Int32" DisplayName="Count the valid claims" sap2010:WorkflowViewState.IdRef="Assign_1" To="[validCount]" Value="[dt_Results.Select(&quot;Status = 'Valid'&quot;).Length]" />
    <Assign x:TypeArguments="x:Int32" DisplayName="Count the rejected claims" sap2010:WorkflowViewState.IdRef="Assign_2" To="[invalidCount]" Value="[dt_Results.Select(&quot;Status = 'Rejected'&quot;).Length]" />
    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="WriteSummary - Invoke Workflow File (Workflows\WriteSummary.xaml)" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_3" UnSafe="False" WorkflowFileName="Workflows\WriteSummary.xaml">
      <ui:InvokeWorkflowFile.Arguments>
        <InArgument x:TypeArguments="sd:DataTable" x:Key="in_dt_Results">[dt_Results]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_SummaryPath">Data/summary.xlsx</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_SheetName">Summary</InArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <ui:LogMessage DisplayName="Log the run totals" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Info" Message="[$&quot;ExpenseFlow run finished. {validCount} claims passed validation, {invalidCount} were rejected.&quot;]" />
  </Sequence>
</Activity>