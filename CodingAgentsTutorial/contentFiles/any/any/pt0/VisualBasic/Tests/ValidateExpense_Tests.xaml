    <Sequence DisplayName="Receipt rule - 250.00 with no receipt is rejected" sap2010:WorkflowViewState.IdRef="Sequence_1">
        <!-- The pattern to copy when you add more cases.

             Given  - set up the claim under test.
             When   - run the workflow under test, nothing else.
             Then   - assert. Verifications belong here and nowhere else. -->
        <Sequence.Variables>
            <Variable x:TypeArguments="x:Double" Name="testAmount" />
            <Variable x:TypeArguments="x:String" Name="testCategory" />
            <Variable x:TypeArguments="x:Boolean" Name="testReceiptAttached" />
            <Variable x:TypeArguments="x:String" Name="testNotes" />
            <Variable x:TypeArguments="x:Boolean" Name="actualIsValid" />
            <Variable x:TypeArguments="x:String" Name="actualMessage" />
        </Sequence.Variables>
        <Sequence DisplayName="Receipt rule - 250.00 with no receipt Given" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <ui:LogMessage DisplayName="Log which case is running" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info">
                <ui:LogMessage.Message>
                    <InArgument x:TypeArguments="x:Object">Test case: a 250.00 Software claim with no receipt must be rejected.</InArgument>
                </ui:LogMessage.Message>
            </ui:LogMessage>
            <Assign x:TypeArguments="x:Double" DisplayName="Amount is 250.00" sap2010:WorkflowViewState.IdRef="Assign_1">
                <Assign.To>
                    <OutArgument x:TypeArguments="x:Double">
                        <VisualBasicReference x:TypeArguments="x:Double" ExpressionText="testAmount" />
                    </OutArgument>
                </Assign.To>
                <Assign.Value>
                    <InArgument x:TypeArguments="x:Double">
                        <VisualBasicValue x:TypeArguments="x:Double" ExpressionText="250.0" />
                    </InArgument>
                </Assign.Value>
            </Assign>
            <Assign x:TypeArguments="x:String" DisplayName="Category is Software" sap2010:WorkflowViewState.IdRef="Assign_2">
                <Assign.To>
                    <OutArgument x:TypeArguments="x:String">
                        <VisualBasicReference x:TypeArguments="x:String" ExpressionText="testCategory" />
                    </OutArgument>
                </Assign.To>
                <Assign.Value>
                    <InArgument x:TypeArguments="x:String">Software</InArgument>
                </Assign.Value>
            </Assign>
            <Assign x:TypeArguments="x:Boolean" DisplayName="No receipt attached" sap2010:WorkflowViewState.IdRef="Assign_3">
                <Assign.To>
                    <OutArgument x:TypeArguments="x:Boolean">
                        <VisualBasicReference x:TypeArguments="x:Boolean" ExpressionText="testReceiptAttached" />
                    </OutArgument>
                </Assign.To>
                <Assign.Value>
                    <InArgument x:TypeArguments="x:Boolean">
                        <VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="False" />
                    </InArgument>
                </Assign.Value>
            </Assign>
            <Assign x:TypeArguments="x:String" DisplayName="No notes" sap2010:WorkflowViewState.IdRef="Assign_4">
                <Assign.To>
                    <OutArgument x:TypeArguments="x:String">
                        <VisualBasicReference x:TypeArguments="x:String" ExpressionText="testNotes" />
                    </OutArgument>
                </Assign.To>
                <Assign.Value>
                    <InArgument x:TypeArguments="x:String">
                        <VisualBasicValue x:TypeArguments="x:String" ExpressionText="String.Empty" />
                    </InArgument>
                </Assign.Value>
            </Assign>
        </Sequence>
        <Sequence DisplayName="Receipt rule - 250.00 with no receipt When" sap2010:WorkflowViewState.IdRef="Sequence_3">
            <ui:InvokeWorkflowFile DisplayName="ValidateExpense - Invoke Workflow File (Workflows\ValidateExpense.xaml)" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1"
                                   ArgumentsVariable="{x:Null}" WorkflowFileName="Workflows\ValidateExpense.xaml" UnSafe="False">
                <ui:InvokeWorkflowFile.Arguments>
                    <InArgument x:TypeArguments="x:Double" x:Key="in_Amount">[testAmount]</InArgument>
                    <InArgument x:TypeArguments="x:String" x:Key="in_Category">[testCategory]</InArgument>
                    <InArgument x:TypeArguments="x:Boolean" x:Key="in_ReceiptAttached">[testReceiptAttached]</InArgument>
                    <InArgument x:TypeArguments="x:String" x:Key="in_Notes">[testNotes]</InArgument>
                    <OutArgument x:TypeArguments="x:Boolean" x:Key="out_IsValid">[actualIsValid]</OutArgument>
                    <OutArgument x:TypeArguments="x:String" x:Key="out_ValidationMessage">[actualMessage]</OutArgument>
                </ui:InvokeWorkflowFile.Arguments>
            </ui:InvokeWorkflowFile>
        </Sequence>
        <Sequence DisplayName="Receipt rule - 250.00 with no receipt Then" sap2010:WorkflowViewState.IdRef="Sequence_4">
            <uta:VerifyExpressionWithOperator DisplayName="Verify the claim was marked invalid" sap2010:WorkflowViewState.IdRef="VerifyExpressionWithOperator_1"
                                              AlternativeVerificationTitle="{x:Null}" KeepScreenshots="{x:Null}" OutputMessageFormat="{x:Null}" Result="{x:Null}" ScreenshotsPath="{x:Null}"
                                              Operator="Equality"
                                              ContinueOnFailure="False" TakeScreenshotInCaseOfFailingAssertion="False" TakeScreenshotInCaseOfSucceedingAssertion="False">
                <uta:VerifyExpressionWithOperator.FirstExpression>
                    <InArgument x:TypeArguments="x:Object">[actualIsValid]</InArgument>
                </uta:VerifyExpressionWithOperator.FirstExpression>
                <uta:VerifyExpressionWithOperator.SecondExpression>
                    <InArgument x:TypeArguments="x:Object">[False]</InArgument>
                </uta:VerifyExpressionWithOperator.SecondExpression>
            </uta:VerifyExpressionWithOperator>
            <uta:VerifyExpressionWithOperator DisplayName="Verify the reason mentions the receipt" sap2010:WorkflowViewState.IdRef="VerifyExpressionWithOperator_2"
                                              AlternativeVerificationTitle="{x:Null}" KeepScreenshots="{x:Null}" OutputMessageFormat="{x:Null}" Result="{x:Null}" ScreenshotsPath="{x:Null}"
                                              Operator="Contains"
                                              ContinueOnFailure="False" TakeScreenshotInCaseOfFailingAssertion="False" TakeScreenshotInCaseOfSucceedingAssertion="False">
                <uta:VerifyExpressionWithOperator.FirstExpression>
                    <InArgument x:TypeArguments="x:Object">[actualMessage]</InArgument>
                </uta:VerifyExpressionWithOperator.FirstExpression>
                <uta:VerifyExpressionWithOperator.SecondExpression>
                    <InArgument x:TypeArguments="x:Object">["receipt"]</InArgument>
                </uta:VerifyExpressionWithOperator.SecondExpression>
            </uta:VerifyExpressionWithOperator>
        </Sequence>
    </Sequence>
